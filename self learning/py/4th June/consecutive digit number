num = input("Enter a number: ")

is_valid = True

for i in range(1, len(num)):
    if int(num[i]) != int(num[i - 1]) + 1:
        is_valid = False
        break

if is_valid:
    print("Every digit is exactly 1 greater than its previous digit.")
else:
    print("The digits do not follow the pattern.")
